{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likemirage.github.io/Tiance-themes/schemas/theme-manifest.schema.json",
  "title": "Tiance Theme Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "author",
    "summary",
    "license",
    "baseColors",
    "preview",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "baseColors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["black", "white", "gray", "red", "orange", "gold", "green", "cyan", "blue", "purple", "pink", "brown"]
      }
    },
    "preview": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.(webp|png|jpg|jpeg)$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeSchemaVersion", "minTianceVersion"],
      "properties": {
        "themeSchemaVersion": {
          "const": 2
        },
        "minTianceVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
